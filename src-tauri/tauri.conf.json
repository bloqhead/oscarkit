{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OSCARKit",
  "version": "0.1.12",
  "identifier": "com.bloqhead.oscarkit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OSCARKit",
        "width": 360,
        "height": 560,
        "minWidth": 300,
        "minHeight": 420,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "media-src": "'self' data:",
        "img-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0NDY5RTY0NkVGQkRCRTAKUldUZzIvdHVaSjVHeElKeG1zemNUQld2eCtNSzJDZlZrK3ZWNHhKOW5MQ3ViUHVmczJFMFlIWUsK",
      "endpoints": [
        "https://github.com/bloqhead/oscarkit/releases/latest/download/latest.json"
      ]
    }
  }
}
